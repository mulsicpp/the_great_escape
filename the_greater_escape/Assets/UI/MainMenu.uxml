<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="root" style="flex-grow: 0; width: 100%; height: 100%; flex-shrink: 0; justify-content: center; flex-direction: column; align-items: center;">
        <ui:Button text="Tutorial" name="Tutorial" />
        <ui:TextField label="Seed" placeholder-text="filler text" name="Seed" />
        <ui:SliderInt label="Size" value="102" high-value="100" name="Size" style="width: 290px;" />
        <ui:Button text="Play" name="Play" style="width: 20%; height: 10%;" />
        <ui:Slider label="Volume" value="42" high-value="100" name="Volume" style="width: 292px;" />
    </ui:VisualElement>
</ui:UXML>
